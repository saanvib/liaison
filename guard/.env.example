# Compliance Guard agent (python -m guard.agent). Copy to guard/.env and fill in; never commit real values.

# Seed for the Guard's stable agent address. Any long secret phrase.
GUARD_SEED=

# Comma-separated agent addresses allowed to send GuardRequest (the Vendor Agent and the Router, D14).
# Requests from anyone else are logged and dropped; an empty list drops everything.
ALLOWED_SENDERS=

# LLM judge and grounding (A9). Without LLM_API_KEY the judge is unavailable and drafts that
# pass the rules come back needs_review (fail closed).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Per-call LLM timeout in seconds; a draft check makes up to two calls within the Vendor's 10 s wait.
GUARD_LLM_TIMEOUT_S=4

# Local port (default 8001).
GUARD_PORT=8001
