# Router / Slack bot (python -m router.agent). Copy to router/.env and fill in; never commit real values.
# Slack setup: router/SLACK_SETUP.md

# Slack tokens: bot token (xoxb-, OAuth & Permissions) and app-level token (xapp-, connections:write).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Agents (A10). VENDOR_ADDRESS is the Vendor Agent's agent1... address; replies from anyone else are dropped.
VENDOR_ADDRESS=
# Seed for the Router's stable address. Any long secret phrase.
ROUTER_SEED=
# Optional: the address this seed produces (printed on start). Give it to the Vendor Agent (ROUTER_ADDRESS)
# and the Guard (ALLOWED_SENDERS). If set here, the Router warns when it doesn't match the seed.
ROUTER_ADDRESS=

# Matched experts get escalations by DM. This channel (ID starts with C; invite the bot) gets the rest:
# questions with no good expert match, or whose expert can't be DMed. That topic's listed experts can answer there.
EXPERTS_CHANNEL=

# Flagged questions ("potentially classified", D23) are DMed to this one named reviewer (member ID, starts with U),
# never matched and never posted in a channel.
FLAGGED_FALLBACK_USER=

# Timers in seconds: wait for the Vendor Agent (A8), reminder to the expert (D8).
VENDOR_WAIT_S=30
REMINDER_AFTER_S=900

# Optional: SQLite file for escalations (default router/router.db) and local agent port (default 8002).
ROUTER_STORE_PATH=router/router.db
ROUTER_PORT=8002
